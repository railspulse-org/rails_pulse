#!/usr/bin/env bash
# frozen_string_literal: true

# tag_release - Create annotated git tag for release
#
# Usage:
#   bin/tag_release <version>                    # Opens editor for notes
#   bin/tag_release <version> --notes "..."      # Use provided notes
#   bin/tag_release --help

set -e

source "$(dirname "${BASH_SOURCE[0]}")/lib/rails_pulse_console.sh"

# Helper function for yes/no prompts
ask_yes_no() {
  local prompt="$1"
  local default="${2:-y}"

  if [ "$default" = "y" ]; then
    prompt="$prompt [Y/n]: "
  else
    prompt="$prompt [y/N]: "
  fi

  while true; do
    read -p "$prompt" -n 1 -r
    echo
    if [ -z "$REPLY" ]; then
      [ "$default" = "y" ] && return 0 || return 1
    fi
    [[ $REPLY =~ ^[Yy]$ ]] && return 0
    [[ $REPLY =~ ^[Nn]$ ]] && return 1
  done
}

# Help
if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
  echo "Usage: bin/tag_release <version> [--notes \"...\"]"
  echo ""
  echo "Creates an annotated git tag for the release."
  echo ""
  echo "Options:"
  echo "  --notes \"...\"   Provide release notes inline"
  echo "                  If not provided, opens \$EDITOR for notes"
  echo ""
  echo "Example:"
  echo "  bin/tag_release 0.3.0"
  echo "  bin/tag_release 0.3.0 --notes \"Bug fixes and improvements\""
  exit 0
fi

# Validate arguments
if [ -z "$1" ]; then
  rp_fail "version number required"
  echo "Usage: bin/tag_release <version> [--notes \"...\"]"
  echo "Run with --help for more information"
  exit 1
fi

VERSION="$1"
TAG_NAME="v$VERSION"

echo
echo "$(rp_rule "TAG RELEASE" "$(rp_dim "$TAG_NAME")")"
echo

# Check if tag already exists
if git rev-parse "$TAG_NAME" >/dev/null 2>&1; then
  rp_fail "tag $TAG_NAME already exists"
  echo "Use 'git tag -d $TAG_NAME' to delete it first"
  exit 1
fi

# Get release notes
NOTES=""
if [ "$2" = "--notes" ]; then
  NOTES="$3"
  if [ -z "$NOTES" ]; then
    rp_fail "--notes requires a value"
    exit 1
  fi
else
  # Try to generate release notes with AI
  USE_AI=false
  AI_CMD=""
  if ask_yes_no "Generate release notes from git history?" "y"; then
    echo ""
    echo "Available AI tools:"
    echo "  1) claude   - Claude AI"
    echo "  2) opencode - Opencode AI"
    echo ""
    while true; do
      read -p "Choose AI tool (1-2): " AI_CHOICE
      case "$AI_CHOICE" in
        1)
          if command -v claude &> /dev/null; then
            AI_CMD="claude --print"
            break
          else
            echo "claude not found. Please install it first."
          fi
          ;;
        2)
          if command -v opencode &> /dev/null; then
            AI_CMD="opencode run"
            break
          else
            echo "opencode not found. Please install it first."
          fi
          ;;
        *)
          echo "Invalid choice. Enter 1 or 2."
          ;;
      esac
    done
    USE_AI=true
  fi

  if [ "$USE_AI" = true ]; then
    # Get the last tag
    LAST_TAG=$(git describe --tags --abbrev=0 2>/dev/null || echo "")

    if [ -z "$LAST_TAG" ]; then
      rp_warn "no previous tags found, analyzing all commits"
      GIT_LOG=$(git log --oneline --no-merges)
      GIT_DIFF_STAT=$(git diff --stat $(git rev-list --max-parents=0 HEAD) HEAD)
    else
      echo "  Last release: $(rp_dim "$LAST_TAG")"
      GIT_LOG=$(git log "$LAST_TAG"..HEAD --oneline --no-merges)
      GIT_DIFF_STAT=$(git diff --stat "$LAST_TAG"..HEAD)
    fi

    echo "  Generating release notes..."
    echo ""

    # Create prompt for AI
    AI_PROMPT="Analyze the following git changes for Rails Pulse v$VERSION and generate professional release notes.

Git commits since last release:
$GIT_LOG

Files changed:
$GIT_DIFF_STAT

Please generate release notes in the following markdown format:

Release v$VERSION

## New Features
[List any new features added]

## Improvements
[List any improvements to existing features]

## Bug Fixes
[List any bug fixes]

## Breaking Changes
[List any breaking changes, or write \"- None\"]

## Upgrade Notes
[List any upgrade steps needed, or write \"- Run 'rails generate rails_pulse:upgrade' after updating\"]

Be concise but descriptive. Focus on user-facing changes. Group related changes together. If a section has no items, write \"- None\" or skip it."

    # Generate notes using selected AI tool.
    # MISE_QUIET silences the "mise ... tools: X" activation banner mise's
    # shims print to stdout on first use per shell — without it, that line
    # gets captured into $TEMPLATE and ends up as junk in the release notes.
    if [ "$AI_CMD" = "claude --print" ]; then
      TEMPLATE=$(echo "$AI_PROMPT" | MISE_QUIET=1 claude --print 2>/dev/null || echo "")
    else
      TEMPLATE=$(MISE_QUIET=1 opencode run "$AI_PROMPT" 2>/dev/null || echo "")
    fi

    # Belt-and-suspenders: strip any stray mise banner line that slips through
    # regardless of source (e.g. a differently-worded notice in a future mise
    # version).
    TEMPLATE=$(echo "$TEMPLATE" | grep -v '^mise .*tools:')

    if [ -z "$TEMPLATE" ]; then
      rp_warn "generation failed, using default template"
      USE_AI=false
    else
      rp_ok "draft generated"
      echo ""
    fi
  fi

  # Fallback to default template if AI not used or failed
  if [ "$USE_AI" = false ]; then
    TEMPLATE=$(cat <<EOF
Release v$VERSION

## New Features


## Improvements


## Bug Fixes


## Breaking Changes
- None

## Upgrade Notes
- Run 'rails generate rails_pulse:upgrade' after updating
EOF
)
  fi

  # Create temp file
  TEMP_FILE=$(mktemp)
  echo "$TEMPLATE" > "$TEMP_FILE"

  # Open editor
  EDITOR=${EDITOR:-vim}
  echo "  Opening editor for release notes... ($EDITOR)"
  echo ""

  $EDITOR "$TEMP_FILE"

  # Read notes
  NOTES=$(cat "$TEMP_FILE")
  rm "$TEMP_FILE"

  # Validate notes aren't empty
  if [ -z "$NOTES" ]; then
    rp_fail "release notes cannot be empty"
    exit 1
  fi
fi

# Create tag
git tag -a "$TAG_NAME" -m "$NOTES"

echo
rp_ok "tag created: $(rp_dim "$TAG_NAME")"
echo
echo "  Release notes:"
echo "$NOTES" | sed 's/^/  /'
echo
echo "$(rp_rule "PASS" "" "$RP_GREEN")"
echo
