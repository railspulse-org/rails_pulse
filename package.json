{
  "name": "rails-pulse",
  "version": "0.1.0",
  "description": "Ruby on Rails performance monitoring tool - Asset Build System",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js",
    "build:dev": "RAILS_PULSE_SOURCE_MAPS=true node scripts/build.js",
    "build:css": "node scripts/build-css.js",
    "build:js": "node scripts/build-js.js",
    "build:icons": "node scripts/build-icons.js",
    "watch": "node scripts/watch.js",
    "dev": "npm run watch",
    "clean": "rimraf public/rails-pulse-assets/rails-pulse*.{css,js,map} vendor/assets/stylesheets/*.{css,map} vendor/assets/javascripts/*.{js,map}",
    "lint:js": "eslint app/javascript scripts test/javascript",
    "lint:js:files": "eslint app/javascript scripts test/javascript --debug 2>&1 | grep 'Linting'",
    "test:js": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:js:watch": "NODE_OPTIONS=--no-experimental-webstorage vitest",
    "test:js:coverage": "NODE_OPTIONS=--no-experimental-webstorage vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@hotwired/stimulus": "^3.2.2",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.16",
    "autoprefixer": "^10.4.16",
    "chokidar": "^4.0.3",
    "cssnano": "^6.0.3",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "glob": "^10.5.0",
    "globals": "^17.5.0",
    "jsdom": "^30.0.1",
    "lucide": "^0.545.0",
    "postcss": "^8.5.26",
    "rimraf": "^5.0.5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.22.2",
    "npm": ">=9.0.0"
  },
  "overrides": {
    "svgo": ">=3.3.3",
    "minimatch": ">=9.0.7"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rails-pulse/rails-pulse.git"
  },
  "keywords": [
    "rails",
    "performance",
    "monitoring",
    "assets",
    "build-system"
  ],
  "author": "Rails Pulse",
  "license": "MIT",
  "optionalDependencies": {
    "@rolldown/binding-linux-arm64-gnu": "1.0.0-rc.17",
    "@rolldown/binding-linux-x64-gnu": "1.0.0-rc.17"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.2",
    "echarts": "^6.1.0",
    "flatpickr": "^4.6.13"
  }
}
