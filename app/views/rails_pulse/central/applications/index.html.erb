<%# Rendered with layout: false: the application layout reads one application's
    tables, and this page belongs to none. Links are generated by the engine's
    mount, with the application as its path segment. %>
<!DOCTYPE html>
<html data-color-scheme="light">
  <head>
    <title>Applications — Rails Pulse</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script nonce="<%= rails_pulse_csp_nonce %>">
      (function() {
        var root = document.documentElement;
        try {
          var stored = localStorage.getItem('color-scheme');
          if (stored === 'dark' || stored === 'light') { root.setAttribute('data-color-scheme', stored); return; }
        } catch (error) {}
        if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
          root.setAttribute('data-color-scheme', 'dark');
        }
      })();
    </script>

    <%# tag.link (not stylesheet_link_tag): middleware fallback paths must stay off asset_host. %>
    <%= tag.link rel: "stylesheet", href: rails_pulse.asset_path("rails-pulse.css") %>
  </head>

  <body class="header-layout">
    <main id="main">
      <div class="container flex flex-col gap">
        <h1 class="font-bold mbs-4">Rails Pulse</h1>

        <% if @applications.any? %>
          <div class="table-scroll">
            <table class="table table-fixed mbs-4">
              <thead>
                <tr>
                  <th>Application</th>
                  <th class="w-56">Last heard from</th>
                </tr>
              </thead>
              <tbody>
                <% @applications.each do |application| %>
                  <tr>
                    <td>
                      <%= link_to application[:name],
                            rails_pulse.root_path(RailsPulse::Central::PATH_PARAMETER => application[:name]) %>
                    </td>
                    <td class="whitespace-nowrap">
                      <% if application[:last_seen_at] %>
                        <%= human_readable_occurred_at(application[:last_seen_at]) %>
                      <% else %>
                        <span class="text-subtle">Nothing received yet</span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="text-subtle">No applications are configured. List them in config.central.applications.</p>
        <% end %>
      </div>
    </main>
  </body>
</html>
