<thead>
  <tr>
    <% columns.each do |column| %>
      <th class="<%= column[:class] %>">
        <%# A column with no field (Tags) has nothing to sort by: ransack would
            emit q[s]=+asc and the controller's default order would apply. %>
        <% if column[:sortable] == false || column[:field].nil? %>
          <%= column[:label] %>
        <% else %>
          <% sort_params = {} %>
          <% sort_params[:zoom_start_time] = @time_range&.zoom_start if @time_range&.zoom_start.present? %>
          <% sort_params[:zoom_end_time] = @time_range&.zoom_end if @time_range&.zoom_end.present? %>
          <% sort_params[:selected_column_time] = params[:selected_column_time] if params[:selected_column_time].present? %>
          <%= sort_link @ransack_query, column[:field], column[:label],
            sort_params.merge(
              class: "flex items-center",
              data: {
                action: "click->rails-pulse--table-sort#updateUrl"
              }
            ) %>
        <% end %>
      </th>
    <% end %>
  </tr>
</thead>
