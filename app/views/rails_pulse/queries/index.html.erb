<%= render "rails_pulse/components/page_header", show_active_filters: true %>

<%= render "rails_pulse/queries/metric_cards" %>

<div
  data-controller="rails-pulse--index rails-pulse--chart-switcher"
  data-rails-pulse--index-chart-id-value="query_performance_chart"
  data-rails-pulse--chart-switcher-selected-value="query_performance"
  data-action="
    rails-pulse--chart-switcher:switched->rails-pulse--index#handleChartSwitched
  "
>
  <%= render 'rails_pulse/components/panel', {
    title: 'Queries',
    card_classes: 'b-full',
    help_heading: 'Query Performance Charts',
    help_text: 'Toggle between different performance metrics to analyze your queries. Query Performance shows P95/P99 latency, Execution Volume shows query frequency patterns, and Database Load tracks database bottlenecks over time.'
  } do %>
    <%# Zone 2: Data filter bar %>
    <div class="filter-bar">
      <%= search_form_for @ransack_query, url: queries_path, class: "filter-bar__form" do |form| %>
        <input
          type="hidden"
          name="chart_type"
          data-rails-pulse--chart-switcher-target="chartTypeInput"
        >
        <%= form.select :avg_duration,
                    duration_options(:query),
                    { selected: @time_range&.selected_response_range },
                    { class: "input" } %>
        <%= if params.has_key?(:q)
          link_to "Reset",
          queries_path,
          class: "btn btn--plain",
          style: "text-decoration: none; color: var(--color-text-muted);"
        end %>
        <%= form.submit "Search", class: "btn" %>
      <% end %>
    </div>

    <% if @has_data %>
      <% if @has_chart_data %>
        <%= render "rails_pulse/queries/chart_tabs" %>
      <% end %>

      <div data-controller="rails-pulse--table-sort">
        <div id="index_table" data-rails-pulse--index-target="indexTable" data-rails-pulse--table-sort-target="tableFrame">
          <%= render "rails_pulse/queries/table" %>
        </div>
      </div>
    <% else %>
      <%= render "rails_pulse/components/empty_state",
      title: "No query data found for the selected filters.",
      description: "Try adjusting your time range or filters to see results." %>
    <% end %>
  <% end %>
</div>
