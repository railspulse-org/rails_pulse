<%= render 'rails_pulse/components/page_header', taggable: @route %>

<%= render "rails_pulse/routes/metric_cards" %>

<div
  class="row"
  data-controller="rails-pulse--index rails-pulse--chart-switcher"
  data-rails-pulse--index-chart-id-value="response_time_percentiles_chart"
  data-rails-pulse--chart-switcher-selected-value="response_time"
  data-action="
    rails-pulse--chart-switcher:switched->rails-pulse--index#handleChartSwitched
  "
>
  <div class="grid-item">
    <%= render 'rails_pulse/components/panel', {
      title: 'Route Requests',
      help_heading: 'Route Performance Charts',
      help_text: 'Toggle between different performance metrics for this route. Response Time shows P95/P99 latency, Request Rate shows traffic patterns, and Error Rate tracks failure rates over time.'
    } do %>
      <div class="filter-bar">
        <%= search_form_for @ransack_query, url: route_path(@route), class: "filter-bar__form" do |form| %>
          <input
            type="hidden"
            name="chart_type"
            data-rails-pulse--chart-switcher-target="chartTypeInput"
          >
          <%= form.select :avg_duration,
            duration_options(:route),
            { selected: @selected_response_range },
            { class: "input" }
          %>
          <%= form.select :http_method_eq,
            [ [ "All Methods", "" ] ] + @route.http_methods_list.sort.map { |m| [ m, m ] },
            { selected: params.dig(:q, :http_method_eq) },
            { class: "input" }
          %>
          <%= link_to "Reset", route_path(@route), class: "btn btn--plain", style: "text-decoration: none; color: var(--color-text-muted);" if params.has_key?(:q) %>
          <%= form.submit "Search", class: "btn" %>
        <% end %>
      </div>

      <% if @has_chart_data %>
        <%= render "rails_pulse/routes/chart_tabs" %>
      <% end %>

      <div data-controller="rails-pulse--table-sort">
        <div id="index_table" data-rails-pulse--index-target="indexTable" data-rails-pulse--table-sort-target="tableFrame">
          <% has_requests = @table_data && @table_data.any? %>
          <% has_archived_summaries = @archived_summary_data && @archived_summary_data.any? %>

          <% if has_requests %>
            <%= render 'rails_pulse/routes/requests_table' %>
          <% end %>

          <% if has_archived_summaries %>
            <h3 class="text-sm font-semibold text-subtle mbs-8 mbe-2">
              Archived data (older than the retention window — aggregated by period)
            </h3>
            <%= render 'rails_pulse/routes/archived_summary_table' %>
          <% end %>

          <% unless has_requests || has_archived_summaries %>
            <%= render 'rails_pulse/components/empty_state',
                title: 'No route requests found for the selected filters.',
                description: 'Try adjusting your time range or filters to see results.' %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
