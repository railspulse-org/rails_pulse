!/public/rails-pulse-assets/*.js
public/rails-pulse-assets/*.map

# Vendor assets for Sprockets/Propshaft integration
!/vendor/assets/
!/vendor/assets/stylesheets/
!/vendor/assets/stylesheets/*.css
vendor/assets/stylesheets/*.map
!/vendor/assets/javascripts/
!/vendor/assets/javascripts/*.js
vendor/assets/javascripts/*.map

